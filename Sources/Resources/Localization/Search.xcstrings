    "search.detail.about": { "extractionState": "manual", "localizations": {
      "ar": { "stringUnit": { "state": "translated", "value": "الإصدار والتحديثات وروابط المشروع." } }, "de": { "stringUnit": { "state": "translated", "value": "Version, Updates und Projektlinks." } }, "en": { "stringUnit": { "state": "translated", "value": "Version, updates, and project links." } }, "es": { "stringUnit": { "state": "translated", "value": "Versión, actualizaciones y enlaces del proyecto." } }, "fr": { "stringUnit": { "state": "translated", "value": "Version, mises à jour et liens du projet." } }, "ja": { "stringUnit": { "state": "translated", "value": "バージョン、アップデート、プロジェクトリンク。" } }, "ko": { "stringUnit": { "state": "translated", "value": "버전, 업데이트 및 프로젝트 링크." } }, "pt": { "stringUnit": { "state": "translated", "value": "Versão, atualizações e links do projeto." } }, "ru": { "stringUnit": { "state": "translated", "value": "Версия, обновления и ссылки проекта." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "版本、更新和项目链接。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "版本、更新與專案連結。" } }
    } },
    "search.detail.general": { "extractionState": "manual", "localizations": {
      "ar": { "stringUnit": { "state": "translated", "value": "المظهر واللغة وأيقونة شريط القوائم والتشغيل عند تسجيل الدخول ونسخ التفضيلات احتياطيًا." } }, "de": { "stringUnit": { "state": "translated", "value": "Erscheinungsbild, Sprache, Menüleistensymbol, Anmeldestart und Einstellungssicherung." } }, "en": { "stringUnit": { "state": "translated", "value": "Appearance, language, menu bar icon, launch at login, and preferences backup." } }, "es": { "stringUnit": { "state": "translated", "value": "Apariencia, idioma, icono de la barra de menús, inicio de sesión y copia de preferencias." } }, "fr": { "stringUnit": { "state": "translated", "value": "Apparence, langue, icône de la barre des menus, ouverture de session et sauvegarde des préférences." } }, "ja": { "stringUnit": { "state": "translated", "value": "外観、言語、メニューバーアイコン、ログイン時の起動、設定のバックアップ。" } }, "ko": { "stringUnit": { "state": "translated", "value": "모양, 언어, 메뉴 막대 아이콘, 로그인 시 실행 및 환경설정 백업." } }, "pt": { "stringUnit": { "state": "translated", "value": "Aparência, idioma, ícone da barra de menus, início de sessão e backup das preferências." } }, "ru": { "stringUnit": { "state": "translated", "value": "Оформление, язык, значок строки меню, запуск при входе и резервная копия настроек." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "外观、语言、菜单栏图标、登录启动和偏好备份。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "外觀、語言、選單列圖示、登入啟動與偏好備份。" } }
    } },
    "search.empty.description": { "extractionState": "manual", "localizations": {
      "ar": { "stringUnit": { "state": "translated", "value": "جرّب اسم إضافة أو إعدادًا أو ميزة أو أمرًا." } }, "de": { "stringUnit": { "state": "translated", "value": "Versuche einen Plugin-Namen, eine Einstellung, Funktion oder einen Befehl." } }, "en": { "stringUnit": { "state": "translated", "value": "Try a plugin name, setting, feature, or command." } }, "es": { "stringUnit": { "state": "translated", "value": "Prueba con el nombre de un plugin, ajuste, función o comando." } }, "fr": { "stringUnit": { "state": "translated", "value": "Essayez un nom de module, un réglage, une fonction ou une commande." } }, "ja": { "stringUnit": { "state": "translated", "value": "プラグイン名、設定、機能、またはコマンドを試してください。" } }, "ko": { "stringUnit": { "state": "translated", "value": "플러그인 이름, 설정, 기능 또는 명령을 검색해 보세요." } }, "pt": { "stringUnit": { "state": "translated", "value": "Tente um nome de plugin, ajuste, recurso ou comando." } }, "ru": { "stringUnit": { "state": "translated", "value": "Попробуйте название плагина, настройку, функцию или команду." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "尝试插件名称、设置、功能或命令。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "嘗試外掛名稱、設定、功能或指令。" } }
    } },
    "search.empty.title": { "extractionState": "manual", "localizations": {
