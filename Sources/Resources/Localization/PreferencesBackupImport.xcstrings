{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "preferencesBackup.preview.installablePlugins" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إضافات مفقودة قابلة للتثبيت" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Installierbare fehlende Plugins" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Missing Plugins Available to Install" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Plugins faltantes disponibles para instalar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Extensions manquantes disponibles à l’installation" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "インストール可能な不足プラグイン" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "설치 가능한 누락 플러그인" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Plugins ausentes disponíveis para instalação" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Доступные для установки отсутствующие плагины" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "可安装的缺失插件" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "可安裝的缺失插件" } } } },
    "preferencesBackup.preview.installablePluginsDescription" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيتم تنزيل الإضافات التي تحددها فقط من قائمة إضافات تم التحقق منها." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nur ausgewählte Plugins werden aus dem verifizierten Plugin-Katalog geladen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Only plugins you select will be downloaded from the verified plugin catalog." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo se descargarán los plugins que selecciones del catálogo de plugins verificado." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Seules les extensions sélectionnées seront téléchargées depuis le catalogue d’extensions vérifié." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したプラグインのみ、検証済みのプラグインカタログからダウンロードされます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택한 플러그인만 검증된 플러그인 카탈로그에서 다운로드됩니다." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Somente os plugins selecionados serão baixados do catálogo de plugins verificado." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Только выбранные вами плагины будут загружены из проверенного каталога плагинов." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅会从已验证的插件列表下载你选中的插件。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅會從已驗證的插件列表下載你選取的插件。" } } } },
    "preferencesBackup.preview.installAndImport" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تثبيت الإضافات المحددة واستيرادها" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Ausgewählte Plugins installieren und importieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Install Selected Plugins and Import" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Instalar plugins seleccionados e importar" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Installer les extensions sélectionnées et importer" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "選択したプラグインをインストールして読み込む" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "선택한 플러그인 설치 및 가져오기" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Instalar plugins selecionados e importar" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Установить выбранные плагины и импортировать" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "安装所选插件并导入" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "安裝所選插件並匯入" } } } }
  },
