{
  "sourceLanguage" : "zh-Hans",
  "strings" : {
    "general.section.preferencesBackup" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "النسخ الاحتياطي للتفضيلات" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Sicherung der Einstellungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preferences Backup" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copia de preferencias" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sauvegarde des préférences" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "環境設定のバックアップ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "환경설정 백업" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Backup de preferências" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Резервная копия настроек" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "偏好设置备份" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "偏好設定備份" } } } },
    "preferencesBackup.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تصدير واستيراد التفضيلات" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen exportieren und importieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Export and Import Preferences" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Exportar e importar preferencias" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Exporter et importer les préférences" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "環境設定をエクスポート／インポート" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "환경설정 내보내기 및 가져오기" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Exportar e importar preferências" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Экспорт и импорт настроек" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导出与导入偏好设置" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "匯出與匯入偏好設定" } } } },
    "preferencesBackup.description" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "يتضمن تفضيلات التطبيق وترتيب عرض الإضافات واختصارات لوحة المفاتيح؛ ولا يتضمن الأذونات أو ذاكرة التخزين المؤقت أو بيانات الإضافات الخاصة." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Enthält App-Einstellungen, Plugin-Anzeigereihenfolge und Tastaturkurzbefehle; Berechtigungen, Caches und private Plug-in-Daten sind ausgeschlossen." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Includes app preferences, plugin display order, and keyboard shortcuts; permissions, caches, and plugin-private data are excluded." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Incluye preferencias de la app, orden de visualización de plugins y atajos de teclado; no incluye permisos, cachés ni datos privados de plugins." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Inclut les préférences de l’app, l’ordre d’affichage des extensions et les raccourcis clavier ; les autorisations, caches et données privées d’extension sont exclus." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリの環境設定、プラグインの表示順、キーボードショートカットを含みます。権限、キャッシュ、プラグイン固有のデータは含まれません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 환경설정, 플러그인 표시 순서, 키보드 단축키를 포함합니다. 권한, 캐시, 플러그인 전용 데이터는 제외됩니다." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Inclui preferências do app, ordem de exibição dos plugins e atalhos de teclado; permissões, caches e dados privados de plugins são excluídos." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Включает настройки приложения, порядок отображения плагинов и сочетания клавиш; разрешения, кэш и приватные данные плагинов исключены." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "包含应用偏好、插件显示顺序与快捷键；不会包含权限、缓存或插件私有数据。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "包含應用程式偏好、插件顯示順序與快速鍵；不會包含權限、快取或插件私有資料。" } } } },
    "preferencesBackup.export" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تصدير التفضيلات…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen exportieren…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Export Preferences…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Exportar preferencias…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Exporter les préférences…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "環境設定を書き出す…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "환경설정 내보내기…" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Exportar preferências…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Экспортировать настройки…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导出偏好设置…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "匯出偏好設定…" } } } },
    "preferencesBackup.import" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استيراد التفضيلات…" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen importieren…" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Import Preferences…" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Importar preferencias…" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Importer les préférences…" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "環境設定を読み込む…" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "환경설정 가져오기…" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Importar preferências…" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Импортировать настройки…" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导入偏好设置…" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "匯入偏好設定…" } } } },
    "preferencesBackup.imported" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم استيراد التفضيلات. تسري إعدادات اللغة بعد إعادة تشغيل MacTools." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Die Einstellungen wurden importiert. Spracheinstellungen werden nach dem Neustart von MacTools wirksam." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preferences imported. Language settings take effect after restarting MacTools." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Preferencias importadas. La configuración de idioma se aplicará al reiniciar MacTools." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Préférences importées. Les réglages de langue prennent effet après le redémarrage de MacTools." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "環境設定を読み込みました。言語設定は MacTools の再起動後に反映されます。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "환경설정을 가져왔습니다. 언어 설정은 MacTools를 재시동한 후 적용됩니다." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Preferências importadas. As configurações de idioma entram em vigor após reiniciar o MacTools." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настройки импортированы. Настройки языка вступят в силу после перезапуска MacTools." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "偏好设置已导入。语言设置将在重启 MacTools 后生效。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "偏好設定已匯入。語言設定將在重新啟動 MacTools 後生效。" } } } },
    "preferencesBackup.alert.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "النسخ الاحتياطي للتفضيلات" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Sicherung der Einstellungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preferences Backup" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Copia de preferencias" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Sauvegarde des préférences" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "環境設定のバックアップ" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "환경설정 백업" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Backup de preferências" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Резервная копия настроек" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "偏好设置备份" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "偏好設定備份" } } } },
    "preferencesBackup.export.prompt" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "احفظ تفضيلات MacTools القابلة للنقل في ملف JSON." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Portable MacTools-Einstellungen als JSON-Datei sichern." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Save portable MacTools preferences as a JSON file." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Guarda las preferencias portátiles de MacTools como archivo JSON." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Enregistrez les préférences portables de MacTools dans un fichier JSON." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "移行可能な MacTools の環境設定を JSON ファイルとして保存します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "이동 가능한 MacTools 환경설정을 JSON 파일로 저장합니다." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Salve as preferências portáteis do MacTools como um arquivo JSON." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сохраните переносимые настройки MacTools в файл JSON." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将可移植的 MacTools 偏好设置保存为 JSON 文件。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將可攜的 MacTools 偏好設定儲存為 JSON 檔案。" } } } },
    "preferencesBackup.exported" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تم تصدير التفضيلات." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen exportiert." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Preferences exported." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Preferencias exportadas." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Préférences exportées." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "環境設定を書き出しました。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "환경설정을 내보냈습니다." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Preferências exportadas." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настройки экспортированы." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "偏好设置已导出。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "偏好設定已匯出。" } } } },
    "preferencesBackup.import.prompt" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختر ملف JSON للتفضيلات تم تصديره من MacTools." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Wählen Sie eine von MacTools exportierte JSON-Einstellungsdatei aus." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Choose a preferences JSON file exported by MacTools." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Elige un archivo JSON de preferencias exportado por MacTools." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Choisissez un fichier JSON de préférences exporté par MacTools." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "MacTools で書き出した環境設定の JSON ファイルを選択します。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "MacTools에서 내보낸 환경설정 JSON 파일을 선택합니다." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Escolha um arquivo JSON de preferências exportado pelo MacTools." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Выберите файл JSON с настройками, экспортированный MacTools." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "选择 MacTools 导出的偏好设置 JSON 文件。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "選擇 MacTools 匯出的偏好設定 JSON 檔案。" } } } },
    "preferencesBackup.preview.title" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "استيراد التفضيلات" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen importieren" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Import Preferences" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Importar preferencias" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Importer les préférences" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "環境設定を読み込む" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "환경설정 가져오기" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Importar preferências" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Импорт настроек" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "导入偏好设置" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "匯入偏好設定" } } } },
    "preferencesBackup.preview.description" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "راجع هذه التغييرات. لا يثبّت الاستيراد الإضافات ولا يغيّر الأذونات أو ذاكرة التخزين المؤقت أو أسرار Keychain أو بيانات الإضافات الخاصة." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Bestätigen Sie diese Änderungen. Der Import installiert keine Plugins und ändert weder Berechtigungen, Caches, Keychain-Geheimnisse noch private Plug-in-Daten." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Review these changes. Import does not install plugins or change permissions, caches, Keychain secrets, or plugin-private data." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Revisa estos cambios. La importación no instala plugins ni modifica permisos, cachés, secretos del llavero ni datos privados de plugins." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Vérifiez ces modifications. L’importation n’installe pas d’extensions et ne modifie ni les autorisations, ni les caches, ni les secrets du trousseau, ni les données privées d’extension." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "変更内容を確認してください。インポートによってプラグインがインストールされたり、権限、キャッシュ、キーチェーンの秘密情報、プラグイン固有データが変更されたりすることはありません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "변경 사항을 확인하세요. 가져오기는 플러그인을 설치하거나 권한, 캐시, 키체인 비밀 정보 또는 플러그인 전용 데이터를 변경하지 않습니다." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Revise estas alterações. A importação não instala plugins nem altera permissões, caches, segredos do Chaves ou dados privados de plugins." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Проверьте эти изменения. Импорт не устанавливает плагины и не изменяет разрешения, кэш, секреты Keychain или приватные данные плагинов." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "请确认以下更改。导入不会安装插件，也不会修改权限、缓存、Keychain 密钥或插件私有数据。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "請確認以下變更。匯入不會安裝插件，也不會修改權限、快取、Keychain 密鑰或插件私有資料。" } } } },
    "preferencesBackup.preview.application" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "تفضيلات التطبيق" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "App-Einstellungen" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "App Preferences" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Preferencias de la app" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Préférences de l’app" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリの環境設定" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 환경설정" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Preferências do app" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настройки приложения" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用偏好" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "應用程式偏好" } } } },
    "preferencesBackup.preview.applicationSummary" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "مظهر التطبيق واللغة وسلوك النقر على شريط القوائم" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "App-Erscheinungsbild, Sprache und Klickverhalten der Menüleiste" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "App appearance, language, and menu bar click behavior" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Apariencia, idioma y comportamiento de clic de la barra de menús" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Apparence de l’app, langue et comportement de clic de la barre des menus" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "アプリの外観、言語、メニューバーのクリック動作" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "앱 모양, 언어 및 메뉴 막대 클릭 동작" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Aparência do app, idioma e comportamento de clique da barra de menus" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Внешний вид приложения, язык и поведение клика по строке меню" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "应用外观、语言和状态栏点击行为" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "應用程式外觀、語言和狀態列點擊行為" } } } },
