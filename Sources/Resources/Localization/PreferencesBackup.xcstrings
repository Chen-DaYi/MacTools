    "preferencesBackup.preview.skipped" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "سيتم تخطي إعدادات %d من الإضافات غير المتاحة و%d من الاختصارات؛ لن يتم تثبيت الإضافات المفقودة." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen für %d nicht verfügbare Plugins und %d Kurzbefehle werden übersprungen; fehlende Plugins werden nicht installiert." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Settings for %d unavailable plugins and %d shortcuts will be skipped; missing plugins are not installed." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Se omitirán los ajustes de %d plugins no disponibles y %d atajos; no se instalarán los plugins que falten." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les réglages de %d extensions indisponibles et %d raccourcis seront ignorés ; les extensions manquantes ne seront pas installées." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "利用できないプラグイン %d 件の設定とショートカット %d 件はスキップされます。不足しているプラグインはインストールされません。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "사용할 수 없는 플러그인 %d개의 설정과 단축키 %d개는 건너뜁니다. 누락된 플러그인은 설치되지 않습니다." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "As configurações de %d plugins indisponíveis e %d atalhos serão ignoradas; plugins ausentes não serão instalados." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настройки для %d недоступных плагинов и %d сочетаний клавиш будут пропущены; отсутствующие плагины не будут установлены." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "将跳过 %d 个本机不可用的插件设置和 %d 项快捷键；不会安装缺失插件。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "將略過 %d 個本機不可用的插件設定和 %d 項快速鍵；不會安裝缺失的插件。" } } } },
