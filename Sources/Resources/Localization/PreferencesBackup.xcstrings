    "preferencesBackup.preview.shortcuts" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "اختصارات لوحة المفاتيح" } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Tastaturkurzbefehle" } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Keyboard Shortcuts" } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Atajos de teclado" } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Raccourcis clavier" } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "キーボードショートカット" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "키보드 단축키" } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Atalhos de teclado" } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Сочетания клавиш" } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "快捷键" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "快速鍵" } } } },
