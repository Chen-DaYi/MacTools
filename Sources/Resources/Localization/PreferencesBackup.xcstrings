    "preferencesBackup.error.unsupportedFormat" : { "extractionState" : "manual", "localizations" : { "ar" : { "stringUnit" : { "state" : "translated", "value" : "إصدار النسخ الاحتياطي للتفضيلات غير مدعوم (%d)." } }, "de" : { "stringUnit" : { "state" : "translated", "value" : "Nicht unterstützte Version der Einstellungssicherung (%d)." } }, "en" : { "stringUnit" : { "state" : "translated", "value" : "Unsupported preferences backup version (%d)." } }, "es" : { "stringUnit" : { "state" : "translated", "value" : "Versión de copia de preferencias no compatible (%d)." } }, "fr" : { "stringUnit" : { "state" : "translated", "value" : "Version de sauvegarde des préférences non prise en charge (%d)." } }, "ja" : { "stringUnit" : { "state" : "translated", "value" : "サポートされていない環境設定バックアップのバージョンです（%d）。" } }, "ko" : { "stringUnit" : { "state" : "translated", "value" : "지원되지 않는 환경설정 백업 버전입니다(%d)." } }, "pt" : { "stringUnit" : { "state" : "translated", "value" : "Versão de backup de preferências não compatível (%d)." } }, "ru" : { "stringUnit" : { "state" : "translated", "value" : "Неподдерживаемая версия резервной копии настроек (%d)." } }, "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "不支持的偏好设置备份版本（%d）。" } }, "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "不支援的偏好設定備份版本（%d）。" } } } },
