      { id: "browser", zh: "浏览器缓存", en: "Browser cache" },
      { id: "logs", zh: "应用日志", en: "App logs" },
    ],
  },
  "xcode-clean": {
    kind: "checks",
    label: { zh: "Xcode 数据", en: "Xcode data" },
    options: [
      { id: "derived", zh: "DerivedData", en: "DerivedData" },
      { id: "devices", zh: "设备支持", en: "Device Support" },
      { id: "archives", zh: "归档", en: "Archives" },
    ],
  },
  "battery-charge-limit": {
    kind: "slider",
    label: { zh: "充电上限", en: "Charge limit" },
    minimum: 50,
    maximum: 100,
    value: 80,
    unit: "%",
  },
  "fan-control": {
    kind: "segments",
    label: { zh: "风扇预设", en: "Fan preset" },
    options: [
      { id: "auto", zh: "自动", en: "Auto" },
      { id: "quiet", zh: "静音", en: "Quiet" },
      { id: "full", zh: "全速", en: "Full" },
    ],
  },
  "activity-bar": {
    kind: "checks",
    label: { zh: "统计项目", en: "Tracking" },
    options: [
      { id: "input", zh: "输入统计", en: "Input" },
      { id: "apps", zh: "前台应用", en: "Apps" },
      { id: "ai", zh: "AI 编程", en: "AI coding" },
