                  <div class="sim-hud-reading"><b data-sim-value>24</b><small>%</small></div>
                  <div class="sim-spark-bars" aria-hidden="true">{sparkBars.map(() => <i></i>)}</div>
                  <footer><span><span data-i18n-zh>8 核</span><span data-i18n-en>8 Core</span></span><span data-sim-footnote>2.8 W</span></footer>
                </section>

                <section class="sim-hud-tile sim-hud-gpu" data-sim-metric="gpu">
                  <header><strong>GPU</strong><span data-sim-temp>47°C</span></header>
                  <div class="sim-hud-reading"><b data-sim-value>18</b><small>%</small></div>
                  <div class="sim-spark-bars" aria-hidden="true">{sparkBars.map(() => <i></i>)}</div>
                  <footer><span>Apple M3</span><span data-sim-footnote>1.4 W</span></footer>
                </section>

                <section class="sim-hud-tile sim-hud-network" data-sim-metric="network">
                  <header><strong><span data-i18n-zh>网络</span><span data-i18n-en>Network</span></strong><span>Wi‑Fi</span></header>
                  <div class="sim-hud-reading"><b data-sim-value>4.8</b><small>MB/s</small></div>
                  <div class="sim-rate-lines" aria-hidden="true"><i></i><i></i></div>
                  <footer><span class="sim-download">↓ <b data-sim-down>3.7</b></span><span class="sim-upload">↑ <b data-sim-up>1.1</b></span></footer>
                </section>

                <section class="sim-hud-tile sim-hud-disk" data-sim-metric="disk">
                  <header><strong><span data-i18n-zh>磁盘</span><span data-i18n-en>Disk</span></strong><span>228 GB</span></header>
                  <div class="sim-hud-reading"><b data-sim-value>41.0</b><small>GB</small></div>
                  <div class="sim-capacity-bar" aria-hidden="true"><i data-sim-capacity></i></div>
                  <footer><span data-i18n-zh>可用</span><span data-i18n-en>Free</span><span data-sim-footnote>82%</span></footer>
                </section>

                <section class="sim-hud-tile sim-hud-memory" data-sim-metric="memory">
                  <header><strong><span data-i18n-zh>内存</span><span data-i18n-en>Memory</span></strong><span>16 GB</span></header>
                  <div class="sim-hud-reading"><b data-sim-value>72</b><small>%</small></div>
                  <div class="sim-memory-bar" aria-hidden="true"><i></i><i></i><i></i></div>
                  <footer><span><span data-i18n-zh>已用</span><span data-i18n-en>Used</span> <b data-sim-used>11.5</b> GB</span><span data-sim-footnote><span data-i18n-zh>0 交换</span><span data-i18n-en>0 swap</span></span></footer>
                </section>

                <section class="sim-hud-tile sim-hud-battery" data-sim-metric="battery">
                  <header><strong><span data-i18n-zh>电池</span><span data-i18n-en>Battery</span></strong><span data-i18n-zh>使用中</span><span data-i18n-en>In use</span></header>
                  <div class="sim-hud-reading"><b data-sim-value>84</b><small>%</small></div>
                  <div class="sim-battery-bar" aria-hidden="true"><i data-sim-capacity></i></div>
                  <footer><span data-i18n-zh>约 7 小时</span><span data-i18n-en>About 7h</span><span data-sim-footnote>32°C</span></footer>
                </section>
              </div>

              <section class="sim-process-card">
                <header><strong><span data-i18n-zh>进程</span><span data-i18n-en>Processes</span></strong><span>CPU&nbsp;&nbsp;&nbsp;MEM</span></header>
