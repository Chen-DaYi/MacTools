{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "error.toggleFailed": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "تعذر تبديل مظهر النظام." } },
        "de": { "stringUnit": { "state": "translated", "value": "Das Systemerscheinungsbild konnte nicht gewechselt werden." } },
        "en": { "stringUnit": { "state": "translated", "value": "Failed to switch the system appearance." } },
        "es": { "stringUnit": { "state": "translated", "value": "No se pudo cambiar la apariencia del sistema." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Impossible de changer l’apparence du système." } },
        "ja": { "stringUnit": { "state": "translated", "value": "システムの外観を切り替えられませんでした。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "시스템 모양을 전환할 수 없습니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Não foi possível alternar a aparência do sistema." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Не удалось изменить оформление системы." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "切换系统外观失败。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "切換系統外觀失敗。" } }
      }
    },
