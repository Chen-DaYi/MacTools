{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "action.confirm.button": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausführen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустить"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل"
          }
        }
      }
    },
    "action.confirm.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The script runs with your user permissions and may access your files and applications."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚本将以你的用户权限运行，并可访问你的文件和应用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "腳本將以你的使用者權限執行，並可存取你的檔案和 App。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Skript wird mit deinen Benutzerrechten ausgeführt und kann auf deine Dateien und Apps zugreifen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El script se ejecuta con tus permisos de usuario y puede acceder a tus archivos y aplicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le script s’exécute avec vos autorisations utilisateur et peut accéder à vos fichiers et applications."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O script é executado com suas permissões de usuário e pode acessar seus arquivos e aplicativos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクリプトはユーザ権限で実行され、ファイルやアプリにアクセスする場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크립트는 사용자 권한으로 실행되며 파일과 앱에 접근할 수 있습니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрипт выполняется с вашими правами пользователя и может получать доступ к файлам и приложениям."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل البرنامج النصي بصلاحيات المستخدم الخاصة بك وقد يصل إلى ملفاتك وتطبيقاتك."
          }
        }
      }
    },
    "action.confirm.title.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run “%@”?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行“%@”？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行「%@」？"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ ausführen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Ejecutar «%@»?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter « %@ » ?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar “%@”?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を実行しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "‘%@’을(를) 실행할까요?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустить «%@»?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل «%@»؟"
          }
        }
      }
    },
    "action.description.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run the saved %@ script."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行已存的 %@ 脚本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行已儲存的 %@ 腳本。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führt das gespeicherte %@-Skript aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecuta el script %@ guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécute le script %@ enregistré."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Executa o script %@ salvo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みの %@ スクリプトを実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 %@ 스크립트를 실행합니다."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает сохранённый скрипт %@."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشغيل برنامج %@ النصي المحفوظ."
          }
        }
      }
    },
    "action.unavailable.interpreter": {
      "extractionState": "manual",
      "localizations": {
