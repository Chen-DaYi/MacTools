    "validation.recoveryRequired": { "extractionState": "manual", "localizations": {
      "ar": { "stringUnit": { "state": "translated", "value": "تعذرت قراءة مكتبة البرامج النصية؛ استورد نسخة احتياطية لاستعادتها." } }, "de": { "stringUnit": { "state": "translated", "value": "Die Skriptbibliothek kann nicht gelesen werden; importiere zur Wiederherstellung ein Backup." } }, "en": { "stringUnit": { "state": "translated", "value": "The script library cannot be read; import a backup to recover it." } }, "es": { "stringUnit": { "state": "translated", "value": "No se puede leer la biblioteca de scripts; importa una copia para recuperarla." } }, "fr": { "stringUnit": { "state": "translated", "value": "La bibliothèque de scripts est illisible ; importez une sauvegarde pour la récupérer." } }, "ja": { "stringUnit": { "state": "translated", "value": "スクリプトライブラリを読み込めません。バックアップを読み込んで復元してください。" } }, "ko": { "stringUnit": { "state": "translated", "value": "스크립트 보관함을 읽을 수 없습니다. 백업을 가져와 복구하십시오." } }, "pt": { "stringUnit": { "state": "translated", "value": "A biblioteca de scripts não pode ser lida; importe um backup para recuperá-la." } }, "ru": { "stringUnit": { "state": "translated", "value": "Библиотека скриптов не читается; импортируйте резервную копию для восстановления." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法读取脚本库；请先导入备份恢复。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法讀取指令碼庫；請先匯入備份以回復。" } }
    } },
    "editor.confirm.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "عند إيقافه، يُشغّل البرنامج النصي فورًا من شبكة الإجراءات وإيماءات لوحة التعقب والاختصارات ومهام سير العمل." } },
        "de": { "stringUnit": { "state": "translated", "value": "Wenn deaktiviert, wird das Skript über Aktionsraster, Trackpad-Gesten, Kurzbefehle und Workflows sofort ausgeführt." } },
        "en": { "stringUnit": { "state": "translated", "value": "Turn this off to run immediately from Action Grid, trackpad gestures, shortcuts, and workflows." } },
        "es": { "stringUnit": { "state": "translated", "value": "Desactívalo para ejecutar inmediatamente desde la Cuadrícula de acciones, los gestos del trackpad, los atajos y los flujos de trabajo." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Désactivez cette option pour exécuter immédiatement depuis la Grille d’actions, les gestes du trackpad, les raccourcis et les workflows." } },
        "ja": { "stringUnit": { "state": "translated", "value": "オフにすると、アクショングリッド、トラックパッドジェスチャ、ショートカット、ワークフローからすぐに実行します。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "끄면 동작 그리드, 트랙패드 제스처, 단축키 및 워크플로에서 즉시 실행합니다." } },
        "pt": { "stringUnit": { "state": "translated", "value": "Desative para executar imediatamente pela Grade de ações, gestos do trackpad, atalhos e fluxos de trabalho." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Отключите, чтобы сразу запускать из Сетки действий, жестов трекпада, сочетаний клавиш и процессов." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "关闭后，从操作网格、触控板手势、快捷键和工作流运行时会立即执行。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "關閉後，從操作網格、觸控板手勢、快捷鍵和工作流程執行時會立即執行。" } }
      }
    }
  },
  "version": "1.0"
