      "ar": { "stringUnit": { "state": "translated", "value": "تعذر حفظ مكتبة البرامج النصية." } }, "de": { "stringUnit": { "state": "translated", "value": "Die Skriptbibliothek konnte nicht gesichert werden." } }, "en": { "stringUnit": { "state": "translated", "value": "Unable to save the script library." } }, "es": { "stringUnit": { "state": "translated", "value": "No se pudo guardar la biblioteca de scripts." } }, "fr": { "stringUnit": { "state": "translated", "value": "Impossible d’enregistrer la bibliothèque de scripts." } }, "ja": { "stringUnit": { "state": "translated", "value": "スクリプトライブラリを保存できません。" } }, "ko": { "stringUnit": { "state": "translated", "value": "스크립트 보관함을 저장할 수 없습니다." } }, "pt": { "stringUnit": { "state": "translated", "value": "Não foi possível salvar a biblioteca de scripts." } }, "ru": { "stringUnit": { "state": "translated", "value": "Не удалось сохранить библиотеку скриптов." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法保存脚本库。" } }, "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法儲存指令碼庫。" } }
