    },
    "permission.accessibility.footnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اسمح لـ MacTools من إعدادات النظام ← الخصوصية والأمان ← تسهيلات الاستخدام. لا يتأثر التبديل التلقائي." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "MacTools unter Systemeinstellungen → Datenschutz & Sicherheit → Bedienungshilfen erlauben. Der automatische Wechsel bleibt verfügbar." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Allow MacTools in System Settings → Privacy & Security → Accessibility. Automatic switching remains available." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Permite MacTools en Ajustes del Sistema → Privacidad y seguridad → Accesibilidad. El cambio automático sigue disponible." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Autorisez MacTools dans Réglages Système → Confidentialité et sécurité → Accessibilité. Le changement automatique reste disponible." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "システム設定 → プライバシーとセキュリティ → アクセシビリティでMacToolsを許可してください。自動切り替えは引き続き利用できます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "시스템 설정 → 개인정보 보호 및 보안 → 손쉬운 사용에서 MacTools를 허용하세요. 자동 전환은 계속 사용할 수 있습니다." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Permita o MacTools em Ajustes do Sistema → Privacidade e Segurança → Acessibilidade. A troca automática continua disponível." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Разрешите MacTools в Системных настройках → Конфиденциальность и безопасность → Универсальный доступ. Автопереключение останется доступным." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "在系统设置 → 隐私与安全性 → 辅助功能中允许 MacTools。自动切换输入法不受影响。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "在系統設定 → 隱私權與安全性 → 輔助使用中允許 MacTools。自動切換輸入法不受影響。" } }
      }
    },
