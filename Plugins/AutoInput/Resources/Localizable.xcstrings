    "settings.hud.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "اعرض مصدر الإدخال الحالي مؤقتًا قرب حقل النص النشط. يتطلب إذن تسهيلات الاستخدام." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Aktuelle Eingabequelle kurz neben dem aktiven Textfeld anzeigen. Benötigt Bedienungshilfen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Briefly show the current input source near the focused text field. Requires Accessibility." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Muestra brevemente la fuente de entrada actual junto al campo de texto activo. Requiere Accesibilidad." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Affiche brièvement la source de saisie près du champ de texte actif. Nécessite Accessibilité." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "フォーカス中のテキストフィールド付近に現在の入力ソースを一時表示します。アクセシビリティが必要です。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "포커스된 텍스트 필드 근처에 현재 입력 소스를 잠시 표시합니다. 손쉬운 사용 권한이 필요합니다." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Mostre brevemente a fonte de entrada atual perto do campo de texto em foco. Requer Acessibilidade." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Кратко показывать текущий источник ввода рядом с активным текстовым полем. Требуется Универсальный доступ." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "聚焦可编辑文本框时，在附近短暂显示当前输入法。需要辅助功能权限。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "聚焦可編輯文字欄位時，在附近短暫顯示目前輸入法。需要輔助使用權限。" } }
