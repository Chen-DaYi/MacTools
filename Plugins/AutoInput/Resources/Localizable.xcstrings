      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "يُستخدم فقط لعرض مصدر الإدخال الحالي قرب حقول النص القابلة للتحرير." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Wird nur verwendet, um die aktuelle Eingabequelle neben bearbeitbaren Textfeldern anzuzeigen." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Used only to show the current input source near editable text fields." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Solo se usa para mostrar la fuente de entrada actual junto a campos de texto editables." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Utilisé uniquement pour afficher la source de saisie actuelle près des champs de texte modifiables." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "編集可能なテキストフィールド付近に現在の入力ソースを表示するためにのみ使用します。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "편집 가능한 텍스트 필드 근처에 현재 입력 소스를 표시하는 데만 사용됩니다." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "Usado apenas para mostrar a fonte de entrada atual perto de campos de texto editáveis." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Используется только для показа текущего источника ввода рядом с редактируемыми текстовыми полями." } },
        "zh-Hans" : { "stringUnit" : { "state" : "translated", "value" : "仅用于在可编辑文本框附近显示当前输入法。" } },
        "zh-Hant" : { "stringUnit" : { "state" : "translated", "value" : "僅用於在可編輯文字欄位附近顯示目前輸入法。" } }
