    "settings.devices.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : { "stringUnit" : { "state" : "translated", "value" : "تبقى إعدادات الجهاز واختصاراته محفوظة أثناء عدم اتصاله." } },
        "de" : { "stringUnit" : { "state" : "translated", "value" : "Einstellungen und Kurzbefehle bleiben erhalten, wenn ein Gerät nicht verfügbar ist." } },
        "en" : { "stringUnit" : { "state" : "translated", "value" : "Device settings and shortcuts remain saved while a device is unavailable." } },
        "es" : { "stringUnit" : { "state" : "translated", "value" : "Los ajustes y atajos se conservan aunque el dispositivo no esté disponible." } },
        "fr" : { "stringUnit" : { "state" : "translated", "value" : "Les réglages et raccourcis restent enregistrés lorsque l’appareil est indisponible." } },
        "ja" : { "stringUnit" : { "state" : "translated", "value" : "デバイスが利用できない間も、設定とショートカットは保存されます。" } },
        "ko" : { "stringUnit" : { "state" : "translated", "value" : "기기를 사용할 수 없어도 설정과 단축키는 저장됩니다." } },
        "pt" : { "stringUnit" : { "state" : "translated", "value" : "As definições e os atalhos permanecem guardados enquanto o dispositivo não está disponível." } },
        "ru" : { "stringUnit" : { "state" : "translated", "value" : "Настройки и сочетания клавиш сохраняются, когда устройство недоступно." } },
