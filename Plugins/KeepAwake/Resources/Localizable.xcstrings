            "value": "No automatic stop"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin parada automática"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas d’arrêt automatique"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動停止なし"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 중지 안 함"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem parada automática"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без автоостановки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会自动停止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不會自動停止"
          }
        }
      }
    },
