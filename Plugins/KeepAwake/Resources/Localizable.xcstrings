          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 켜 두기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter tela ligada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не гасить экран"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持常亮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持常亮"
          }
        }
      }
    },
    "settings.display.keepOn.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع Mac والشاشة من الدخول في وضع السكون بسبب الخمول. ولا يتجاوز شاشة القفل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert den Ruhezustand von Mac und Display bei Inaktivität. Umgeht den Sperrbildschirm nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevents idle sleep for the Mac and display. Does not bypass the lock screen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que el Mac y la pantalla entren en reposo por inactividad. No elude la pantalla bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la mise en veille du Mac et de l’écran en cas d’inactivité. Ne contourne pas l’écran verrouillé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macとディスプレイのアイドルスリープを防ぎます。ロック画面は回避しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac과 디스플레이가 유휴 상태에서 잠자기 모드로 전환되지 않게 합니다. 잠금 화면은 우회하지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita que o Mac e a tela entrem em repouso por inatividade. Não ignora a tela bloqueada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предотвращает переход Mac и экрана в режим сна при бездействии. Не обходит экран блокировки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "防止 Mac 和屏幕因空闲而休眠。不会绕过锁定屏幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "防止 Mac 和螢幕因閒置而進入睡眠。不會略過鎖定畫面。"
          }
        }
      }
    },
    "error.invalidEndDate": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون وقت التوقف التلقائي متأخرًا عن الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Stoppzeit muss später als jetzt liegen."
          }
        },
        "en": {
          "stringUnit": {
