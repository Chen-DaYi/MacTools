{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البقاء مستيقظًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerse despierto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester éveillé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きていてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있으십시오"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se acordado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не спать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع سكون النظام؛ ويمكن اختياريًا إبقاء الشاشة قيد التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert den Ruhezustand des Systems; optional bleibt das Display an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent idle system sleep; optionally keep the display on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la suspensión del sistema; opcionalmente mantiene la pantalla encendida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la mise en veille du système ; option pour garder l’écran allumé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのアイドルスリープを防止。必要に応じてディスプレイもオンのままにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 유휴 절전을 방지하며, 선택적으로 디스플레이를 켜 둡니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede a suspensão ociosa do sistema; opcionalmente mantém a tela ligada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предотвращает спящий режим системы; по желанию не даёт экрану гаснуть."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止系统空闲休眠；可选保持屏幕常亮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止系統空閒休眠；可選保持螢幕常亮"
          }
        }
      }
    },
    "panel.duration.forever": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبدًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemals"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決して"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절대로"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永不"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永不"
          }
        }
      }
    },
    "panel.duration.noAutomaticStop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا إيقاف تلقائي"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein automatischer Stopp"
          }
