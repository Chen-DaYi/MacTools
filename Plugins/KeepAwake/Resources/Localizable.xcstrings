    "panel.display.allowSleep": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السماح بالإطفاء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausschalten erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow turning off"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir apagado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser l’extinction"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消灯を許可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끄기 허용"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir desligar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить выключение"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "允許關閉"
          }
        }
      }
    },
    "panel.display.allowSleep.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى الـ Mac مستيقظًا؛ ويمكن للشاشة أن تنام وفق إعدادات النظام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac bleibt wach; Display kann laut Systemeinstellungen schlafen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac stays awake; display can sleep per System Settings"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac sigue activo; la pantalla puede apagarse según Ajustes del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac reste éveillé ; l’écran peut s’éteindre selon Réglages Système"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac は起動したまま。ディスプレイはシステム設定どおりスリープ可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac은 깨어 있고, 디스플레이는 시스템 설정에 따라 꺼질 수 있음"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac permanece ativo; a tela pode hibernar conforme Ajustes do Sistema"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не засыпает; экран может гаснуть по настройкам системы"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统保持唤醒，屏幕可按系统设置关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統保持喚醒，螢幕可依系統設定關閉"
          }
        }
      }
    },
    "panel.display.keepOn": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء الشاشة مضاءة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Display an lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep display on"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener pantalla encendida"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder l’écran allumé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイをオンのまま"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이 켜 두기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter tela ligada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не гасить экран"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持常亮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "保持常亮"
          }
        }
      }
    },
    "panel.display.keepOn.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدخل الـ Mac ولا الشاشة سكون الخمول؛ ولا يتجاوز القفل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weder Mac noch Display im Leerlauf; sperrt die Sperre nicht aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither Mac nor display idle-sleep; does not bypass lock"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni el Mac ni la pantalla duermen por inactividad; no evita el bloqueo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni le Mac ni l’écran ne s’endorment en inactivité ; n’empêche pas le verrouillage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac もディスプレイもアイドルスリープしません。ロックは回避しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac과 디스플레이 모두 유휴 절전하지 않음. 잠금은 우회하지 않음"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem o Mac nem a tela hibernam por ociosidade; não ignora o bloqueio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни Mac, ни экран не засыпают от бездействия; блокировку не отключает"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统与屏幕均不因空闲关闭；不会解除锁屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統與螢幕均不因空閒關閉；不會解除鎖定畫面"
          }
        }
      }
    },
    "error.invalidEndDate": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون وقت التوقف التلقائي متأخرًا عن الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die automatische Stoppzeit muss später als jetzt liegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The automatic stop time must be later than now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hora de parada automática debe ser posterior a la actual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'heure d'arrêt automatique doit être postérieure à celle actuelle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自動停止時刻は現在より遅くする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 정지 시간은 지금보다 이후여야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário de parada automática deve ser posterior ao atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время автоматической остановки должно быть позже, чем сейчас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动停止时间必须晚于当前时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動停止時間必須晚於當前時間。"
          }
        }
      }
    },
    "error.assertionCreationFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير قادر على إبقاء النظام نشطًا. خطأ في النظام %d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System kann nicht wach gehalten werden. Systemfehler %d."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to keep the system awake. System error %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede mantener el sistema despierto. Error del sistema %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de maintenir le système éveillé. Erreur système %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムを起動状態に保つことができません。システム エラー %d。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템을 활성 상태로 유지할 수 없습니다. 시스템 오류 %d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível manter o sistema ativado. Erro de sistema %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно поддерживать бодрствование системы. Системная ошибка %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启用阻止休眠，系统返回错误 %d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟用阻止休眠，系統返回錯誤 %d。"
          }
        }
      }
    },
    "error.displayAssertionCreationFailedFormat": {
