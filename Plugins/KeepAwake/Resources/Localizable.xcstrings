    "panel.display.allowSleep.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac stays awake; display can sleep per System Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统保持唤醒，屏幕可按系统设置关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統保持喚醒，螢幕可依系統設定關閉"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac bleibt wach; Display kann laut Systemeinstellungen schlafen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac sigue activo; la pantalla puede apagarse según Ajustes del sistema"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac reste éveillé ; l’écran peut s’éteindre selon Réglages Système"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac は起動したまま。ディスプレイはシステム設定どおりスリープ可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac은 깨어 있고, 디스플레이는 시스템 설정에 따라 꺼질 수 있음"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac permanece ativo; a tela pode hibernar conforme Ajustes do Sistema"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не засыпает; экран может гаснуть по настройкам системы"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى الـ Mac مستيقظًا؛ ويمكن للشاشة أن تنام وفق إعدادات النظام"
          }
        }
      }
    },
    "panel.display.keepOn.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neither Mac nor display idle-sleep; does not bypass lock"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统与屏幕均不因空闲关闭；不会解除锁屏"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統與螢幕均不因空閒關閉；不會解除鎖定畫面"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weder Mac noch Display im Leerlauf; sperrt die Sperre nicht aus"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni el Mac ni la pantalla duermen por inactividad; no evita el bloqueo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni le Mac ni l’écran ne s’endorment en inactivité ; n’empêche pas le verrouillage"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac もディスプレイもアイドルスリープしません。ロックは回避しません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac과 디스플레이 모두 유휴 절전하지 않음. 잠금은 우회하지 않음"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem o Mac nem a tela hibernam por ociosidade; não ignora o bloqueio"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ни Mac, ни экран не засыпают от бездействия; блокировку не отключает"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يدخل الـ Mac ولا الشاشة سكون الخمول؛ ولا يتجاوز القفل"
          }
        }
      }
    },
