            "value": "Крышка закрыта"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖唤醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔蓋喚醒"
          }
        }
      }
    },
