        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jamais"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "決して"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절대로"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "永不"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "永不"
          }
        }
      }
    },
    "panel.subtitle.remainingMinutesFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف تلقائيًا خلال %d دقيقة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppt automatisch in %d Minuten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops automatically in %d minutes"
