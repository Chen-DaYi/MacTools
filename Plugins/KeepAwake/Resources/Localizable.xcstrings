          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Display konnte nicht wach gehalten werden. Systemfehler %d."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not keep the display on. System error %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
