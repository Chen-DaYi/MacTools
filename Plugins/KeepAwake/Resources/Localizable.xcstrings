    "settings.lidClose.keepAwake": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إبقاء Mac مستيقظًا عند إغلاق الغطاء"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei geschlossenem Deckel wach halten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep awake with lid closed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener activo con la tapa cerrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester actif avec le couvercle fermé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイを閉じてもスリープさせない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫아도 깨우기"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter ativo com a tampa fechada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не засыпать при закрытой крышке"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖时保持唤醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔蓋時保持喚醒"
          }
        }
      }
    },
    "settings.lidClose.unavailable.notebook": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاح فقط على أجهزة Mac المحمولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur auf Mac-Notebooks verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available only on Mac laptops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible solo en portátiles Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible uniquement sur les ordinateurs portables Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macノートブックでのみ使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 노트북에서만 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível apenas em notebooks Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно только на ноутбуках Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅适用于 Mac 笔记本电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅適用於 Mac 筆記型電腦。"
          }
        }
      }
    },
    "settings.lidClose.unavailable.power": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متاح عند توصيل الطاقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar, wenn das Netzteil angeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available when connected to power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible cuando está conectado a la corriente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponible lorsque le Mac est branché sur secteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電源接続時に使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전원에 연결하면 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponível quando conectado à energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступно при подключении к питанию."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接电源后可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接電源後可用。"
          }
        }
      }
    },
    "settings.lidClose.keepAwake.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع السكون عند إغلاق الغطاء؛ حافظ على التهوية ولا تضع Mac في حقيبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert den Ruhezustand bei geschlossenem Deckel. Für Belüftung sorgen und nicht in einer Tasche verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevents lid-close sleep. Keep the Mac ventilated and out of bags."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la suspensión al cerrar la tapa. Mantén el Mac ventilado y fuera de bolsas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la mise en veille à la fermeture. Gardez le Mac ventilé et hors de tout sac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイを閉じたときのスリープを防ぎます。通気を確保し、バッグには入れないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫을 때 잠자기를 방지합니다. 통풍을 유지하고 가방에 넣지 마십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede a suspensão ao fechar a tampa. Mantenha o Mac ventilado e fora de bolsas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт Mac уснуть при закрытии крышки. Обеспечьте вентиляцию и не кладите Mac в сумку."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止合盖休眠；请保持通风，勿放入包中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止闔蓋睡眠；請保持通風，勿放入包中。"
          }
        }
      }
    },
    "error.lidCloseRequiresPortableMac": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يتوفر إبقاء Mac مستيقظًا والغطاء مغلق إلا على أجهزة Mac المحمولة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrieb mit geschlossenem Deckel ist nur auf Mac-Notebooks verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping awake with the lid closed is available only on Mac laptops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerse activo con la tapa cerrada solo está disponible en portátiles Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le maintien actif avec le couvercle fermé est disponible uniquement sur les ordinateurs portables Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた状態での動作はMacノートブックでのみ使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫은 상태로 깨우기는 Mac 노트북에서만 사용할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter ativo com a tampa fechada está disponível apenas em notebooks Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Работа с закрытой крышкой доступна только на ноутбуках Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "合盖保持唤醒仅适用于 Mac 笔记本电脑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "闔蓋保持喚醒僅適用於 Mac 筆記型電腦。"
          }
        }
      }
    },
    "error.lidCloseRequiresExternalPower": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وصّل Mac بالطاقة قبل تمكين إبقائه مستيقظًا والغطاء مغلق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe das Netzteil an, bevor du den Betrieb mit geschlossenem Deckel aktivierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect the Mac to power before enabling closed-lid operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta el Mac a la corriente antes de activar el funcionamiento con la tapa cerrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Branchez le Mac sur secteur avant d’activer le fonctionnement couvercle fermé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた状態での動作を有効にする前に、Macを電源に接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫은 상태로 실행하기 전에 Mac을 전원에 연결하십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte o Mac à energia antes de ativar o funcionamento com a tampa fechada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите Mac к питанию, прежде чем включать работу с закрытой крышкой."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接电源后才能启用合盖保持唤醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接電源後才能啟用闔蓋保持喚醒。"
          }
        }
      }
    },
    "error.lidCloseAssertionCreationFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إبقاء Mac مستيقظًا والغطاء مغلق. خطأ النظام %d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrieb mit geschlossenem Deckel konnte nicht aktiviert werden. Systemfehler %d."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not enable closed-lid operation. System error %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo activar el funcionamiento con la tapa cerrada. Error del sistema %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d’activer le fonctionnement couvercle fermé. Erreur système %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた状態での動作を有効にできませんでした。システムエラー%d。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫은 상태로 실행할 수 없습니다. 시스템 오류 %d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ativar o funcionamento com a tampa fechada. Erro do sistema %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось включить работу с закрытой крышкой. Системная ошибка %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启用合盖保持唤醒，系统返回错误 %d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟用闔蓋保持喚醒，系統傳回錯誤 %d。"
          }
        }
      }
    },
    "error.lidCloseAssertionReleaseFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر إيقاف إبقاء Mac مستيقظًا والغطاء مغلق. خطأ النظام %d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Betrieb mit geschlossenem Deckel konnte nicht deaktiviert werden. Systemfehler %d."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not disable closed-lid operation. System error %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo desactivar el funcionamiento con la tapa cerrada. Error del sistema %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de désactiver le fonctionnement couvercle fermé. Erreur système %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じた状態での動作を無効にできませんでした。システムエラー%d。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개를 닫은 상태로 실행을 중지할 수 없습니다. 시스템 오류 %d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível desativar o funcionamento com a tampa fechada. Erro do sistema %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отключить работу с закрытой крышкой. Системная ошибка %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法关闭合盖保持唤醒，系统返回错误 %d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法關閉闔蓋保持喚醒，系統傳回錯誤 %d。"
          }
        }
      }
    },
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البقاء مستيقظًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerse despierto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester éveillé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きていてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있으십시오"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se acordado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не спать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع سكون النظام؛ ويمكن إبقاء الشاشة قيد التشغيل أو تشغيل Mac والغطاء مغلق عند توصيل الطاقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert den Ruhezustand des Systems; optional bleibt das Display an oder der Mac läuft am Netzteil mit geschlossenem Deckel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent idle system sleep; optionally keep the display on or run with the lid closed while on power."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la suspensión del sistema; opcionalmente mantiene la pantalla encendida o funciona con la tapa cerrada al conectarse a la corriente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la mise en veille du système ; option pour garder l’écran allumé ou fonctionner couvercle fermé sur secteur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのアイドルスリープを防止。必要に応じてディスプレイをオンのままにするか、電源接続時に閉じた状態で動作できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 유휴 절전을 방지하며, 선택적으로 디스플레이를 켜 두거나 전원 연결 시 덮개를 닫은 채 실행합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede a suspensão ociosa do sistema; opcionalmente mantém a tela ligada ou funciona com a tampa fechada quando conectado à energia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предотвращает спящий режим системы; по желанию не даёт экрану гаснуть или позволяет работать с закрытой крышкой при питании от сети."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止系统空闲休眠；可选保持屏幕常亮，或接通电源时合盖运行"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止系統空閒休眠；可選保持螢幕常亮，或接通電源時闔蓋運作"
          }
        }
      }
    },
