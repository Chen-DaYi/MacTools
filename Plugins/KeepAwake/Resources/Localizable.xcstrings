{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "البقاء مستيقظًا"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wach bleiben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep Awake"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenerse despierto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rester éveillé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きていてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깨어 있으십시오"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha-se acordado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не спать"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止休眠"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prevent idle system sleep; optionally keep the display on."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止系统空闲休眠；可选保持屏幕常亮"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "阻止系統空閒休眠；可選保持螢幕常亮"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verhindert den Ruhezustand des Systems; optional bleibt das Display an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Evita la suspensión del sistema; opcionalmente mantiene la pantalla encendida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empêche la mise en veille du système ; option pour garder l’écran allumé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのアイドルスリープを防止。必要に応じてディスプレイもオンのままにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 유휴 절전을 방지하며, 선택적으로 디스플레이를 켜 둡니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Impede a suspensão ociosa do sistema; opcionalmente mantém a tela ligada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предотвращает спящий режим системы; по желанию не даёт экрану гаснуть."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع سكون النظام؛ ويمكن اختياريًا إبقاء الشاشة قيد التشغيل."
          }
        }
      }
    },
    "panel.subtitle.enabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On · Display may turn off"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用 · 允许屏幕关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用 · 允許螢幕關閉"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiv · Display darf ausgehen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado · La pantalla puede apagarse"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé · L’écran peut s’éteindre"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オン · ディスプレイ消灯可"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용 중 · 디스플레이 끄기 허용"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativo · Tela pode desligar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вкл. · Экран может гаснуть"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفعّل · يمكن إطفاء الشاشة"
          }
        }
      }
    },
    "panel.duration.forever": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبدًا"
