            "state": "translated",
            "value": "自動停止時刻は現在より遅くする必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동 정지 시간은 지금보다 이후여야 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O horário de parada automática deve ser posterior ao atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время автоматической остановки должно быть позже, чем сейчас."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动停止时间必须晚于当前时间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動停止時間必須晚於當前時間。"
          }
        }
      }
    },
    "error.assertionCreationFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير قادر على إبقاء النظام نشطًا. خطأ في النظام %d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System kann nicht wach gehalten werden. Systemfehler %d."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unable to keep the system awake. System error %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede mantener el sistema despierto. Error del sistema %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de maintenir le système éveillé. Erreur système %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムを起動状態に保つことができません。システム エラー %d。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템을 활성 상태로 유지할 수 없습니다. 시스템 오류 %d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível manter o sistema ativado. Erro de sistema %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно поддерживать бодрствование системы. Системная ошибка %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启用阻止休眠，系统返回错误 %d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法啟用阻止休眠，系統返回錯誤 %d。"
          }
        }
      }
    },
    "error.displayAssertionCreationFailedFormat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إبقاء الشاشة مضاءة. خطأ النظام %d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Display konnte nicht wach gehalten werden. Systemfehler %d."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not keep the display on. System error %d."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo mantener la pantalla encendida. Error del sistema %d."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de garder l’écran allumé. Erreur système %d."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスプレイをオンのままにできませんでした。システムエラー %d。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "디스플레이를 켠 상태로 유지할 수 없습니다. 시스템 오류 %d."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível manter a tela ligada. Erro do sistema %d."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось оставить экран включённым. Системная ошибка %d."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保持屏幕常亮，系统返回错误 %d。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法保持螢幕常亮，系統返回錯誤 %d。"
          }
        }
      }
    },
    "error.displayAssertionReleaseFailedFormat": {
