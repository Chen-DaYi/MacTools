{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "panel.lidClose.indicator": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الغطاء مغلق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deckelmodus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lid closed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapa cerrada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couvercle fermé"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラムシェル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "덮개 닫힘"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampa fechada"
          }
        },
        "ru": {
