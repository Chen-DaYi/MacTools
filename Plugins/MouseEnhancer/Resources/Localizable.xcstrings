    "panel.subtitle.enabledFormat": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "مفعّل · %@ · %@" } },
        "de": { "stringUnit": { "state": "translated", "value": "Ein · %@ · %@" } },
        "en": { "stringUnit": { "state": "translated", "value": "On · %@ · %@" } },
        "es": { "stringUnit": { "state": "translated", "value": "Activado · %@ · %@" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Activé · %@ · %@" } },
        "ja": { "stringUnit": { "state": "translated", "value": "オン · %@ · %@" } },
        "ko": { "stringUnit": { "state": "translated", "value": "켜짐 · %@ · %@" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Ativado · %@ · %@" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Включено · %@ · %@" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "已开启 · %@ · %@" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "已開啟 · %@ · %@" } }
      }
    },
    "panel.subtitle.needsAccessibility": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب إذن الوصول قبل التمكين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor der Aktivierung ist eine Zugriffsberechtigung erforderlich"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere permiso de accesibilidad antes de habilitar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisation d'accessibilité requise avant l'activation"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効にする前にアクセシビリティ権限が必要です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화하려면 접근성 권한이 필요합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Permissão de acessibilidade necessária antes de ativar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед включением требуется разрешение на доступность"
          }
        },
        "en": { "stringUnit": { "state": "translated", "value": "Accessibility permission required before enabling" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "启用前需要辅助功能授权" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "啟用前需要輔助使用授權" } }
      }
    },
    "panel.subtitle.off": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم تمكين أي تحسين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Erweiterung aktiviert"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna mejora habilitada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune amélioration activée"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な拡張機能はありません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화된 개선 사항이 없습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum aprimoramento ativado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшения не включены"
          }
        },
        "en": { "stringUnit": { "state": "translated", "value": "No enhancement enabled" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "未启用增强功能" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "未啟用增強功能" } }
      }
    },
    "panel.subtitle.middleClickEnabledFormat": {
      "localizations": {
        "ar": { "stringUnit": { "state": "translated", "value": "النقر الأوسط · %d أصابع" } },
        "de": { "stringUnit": { "state": "translated", "value": "Mittelklick · %d Finger" } },
        "en": { "stringUnit": { "state": "translated", "value": "Middle click · %d fingers" } },
        "es": { "stringUnit": { "state": "translated", "value": "Clic central · %d dedos" } },
        "fr": { "stringUnit": { "state": "translated", "value": "Clic central · %d doigts" } },
        "ja": { "stringUnit": { "state": "translated", "value": "中央クリック · %d 本指" } },
        "ko": { "stringUnit": { "state": "translated", "value": "가운데 클릭 · %d손가락" } },
        "pt": { "stringUnit": { "state": "translated", "value": "Clique do meio · %d dedos" } },
        "ru": { "stringUnit": { "state": "translated", "value": "Средний щелчок · %d пальцев" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "模拟中键 · %d指" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "模擬中鍵 · %d指" } }
      }
    },
    "permission.accessibility.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع لأحداث التمرير ويرسل نقرات متوسطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hört auf Scroll-Ereignisse und sendet Mittelklicks."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escucha eventos de desplazamiento y envía clics centrales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écoute les événements de défilement et envoie des clics du milieu."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロール イベントをリッスンし、中クリックを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤 이벤트를 수신하고 중간 클릭을 보냅니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escuta eventos de rolagem e envia cliques do meio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прослушивает события прокрутки и отправляет средние щелчки."
          }
        },
        "en": { "stringUnit": { "state": "translated", "value": "Listens for scroll events and sends middle clicks." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于监听滚动事件和发送中键点击。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "用於監聽滾動事件和傳送中鍵點按。" } }
      }
    },
    "permission.accessibility.footnote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات النظام ← الخصوصية والأمان ← إمكانية الوصول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemeinstellungen → Datenschutz und Sicherheit → Barrierefreiheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuración del sistema → Privacidad y seguridad → Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paramètres système → Confidentialité et sécurité → Accessibilité."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定→プライバシーとセキュリティ→アクセシビリティ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 개인 정보 보호 및 보안 → 접근성."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurações do sistema → Privacidade e segurança → Acessibilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системные настройки → Конфиденциальность и безопасность → Доступность."
          }
        },
        "en": { "stringUnit": { "state": "translated", "value": "System Settings → Privacy & Security → Accessibility." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "系统设置 → 隐私与安全性 → 辅助功能，允许 MacTools。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "系統設定 → 隱私權與安全性 → 輔助使用，允許 MacTools。" } }
      }
    },
