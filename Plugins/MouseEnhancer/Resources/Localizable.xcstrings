{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "error.accessibilityRequired": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Mouse Enhancer إلى إذن الوصول. قم بمنح حق الوصول في إعدادات النظام أولاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Enhancer benötigt eine Barrierefreiheitsberechtigung. Gewähren Sie zunächst den Zugriff in den Systemeinstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Enhancer necesita permiso de Accesibilidad. Primero conceda acceso en Configuración del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Enhancer nécessite une autorisation d’accessibilité. Accordez d'abord l'accès dans les paramètres système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウス エンハンサーにはアクセシビリティ権限が必要です。まずシステム設定でアクセスを許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Enhancer에는 접근성 권한이 필요합니다. 먼저 시스템 설정에서 액세스 권한을 부여하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mouse Enhancer precisa de permissão de acessibilidade. Conceda acesso primeiro nas configurações do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mouse Enhancer требует разрешения на специальные возможности. Сначала предоставьте доступ в настройках системы."
          }
        },
        "en": { "stringUnit": { "state": "translated", "value": "Mouse Enhancer needs Accessibility permission. Grant access in System Settings first." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "鼠标增强需要辅助功能权限，请先前往设置完成授权。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "滑鼠增強需要輔助使用權限，請先前往設定完成授權。" } }
      }
    },
    "error.accessibilityRevoked": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذن الوصول معطل. تم إيقاف مُحسِّن الماوس مؤقتًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Barrierefreiheitsberechtigung ist deaktiviert. Mouse Enhancer wurde angehalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El permiso de accesibilidad está desactivado. Mouse Enhancer se ha detenido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'autorisation d'accessibilité est désactivée. Mouse Enhancer est en pause."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ許可がオフになっています。マウス エンハンサーは一時停止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근성 권한이 꺼져 있습니다. Mouse Enhancer가 일시 중지되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A permissão de acessibilidade está desativada. O Mouse Enhancer foi pausado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешение на доступ отключено. Работа Mouse Enhancer приостановлена."
          }
        },
        "en": { "stringUnit": { "state": "translated", "value": "Accessibility permission is off. Mouse Enhancer has paused." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "辅助功能权限已关闭，鼠标增强已暂停。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "輔助使用權限已關閉，滑鼠增強已暫停。" } }
      }
    },
    "error.tapUnavailable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر بدء مراقبة حدث التمرير. قم بتأكيد إذن الوصول وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Scroll-Ereignisüberwachung konnte nicht gestartet werden. Bestätigen Sie die Barrierefreiheitsberechtigung und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la supervisión de eventos de desplazamiento. Confirme el permiso de Accesibilidad e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de démarrer la surveillance des événements de défilement. Confirmez l'autorisation d'accessibilité et réessayez."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スクロールイベント監視を開始できませんでした。アクセシビリティ権限を確認して、再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스크롤 이벤트 모니터링을 시작할 수 없습니다. 접근성 권한을 확인하고 다시 시도하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o monitoramento de eventos de rolagem. Confirme a permissão de acessibilidade e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось запустить мониторинг событий прокрутки. Подтвердите разрешение на доступность и повторите попытку."
          }
        },
        "en": { "stringUnit": { "state": "translated", "value": "Could not start scroll event monitoring. Confirm Accessibility permission and try again." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法启动滚动事件监听，请确认辅助功能授权后重试。" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "無法啟動滾動事件監聽，請確認輔助使用授權後重試。" } }
      }
    },
    "metadata.description": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحسين عناصر التحكم في الماوس ولوحة التتبع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbessern Sie die Maus- und Trackpad-Steuerung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mejore los controles del mouse y del trackpad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorez les contrôles de la souris et du trackpad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスとトラックパッドのコントロールを強化します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 및 트랙패드 컨트롤이 향상되었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprimore os controles do mouse e do trackpad."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Улучшите управление мышью и трекпадом."
          }
        },
        "en": { "stringUnit": { "state": "translated", "value": "Enhance mouse and trackpad controls." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "增强鼠标与触控板控制" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "增強滑鼠與觸控板控制" } }
      }
    },
    "metadata.title": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محسن الماوس"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mausverstärker"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Potenciador de ratón"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Améliorateur de souris"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マウスエンハンサー"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마우스 강화제"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprimorador de mouse"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Усилитель мыши"
          }
        },
        "en": { "stringUnit": { "state": "translated", "value": "Mouse Enhancer" } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "鼠标增强" } },
        "zh-Hant": { "stringUnit": { "state": "translated", "value": "滑鼠增強" } }
      }
    },
    "panel.button.settings": {
      "localizations": {
