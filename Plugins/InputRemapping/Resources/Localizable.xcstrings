    "metadata.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Trigger shortcuts with extra mouse buttons." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "使用额外鼠标按键触发快捷操作" } } } },
    "metadata.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Input Remapping" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "输入重映射" } } } },
