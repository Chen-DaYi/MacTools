    "permission.inputMonitoring.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Used to monitor extra mouse buttons system-wide. All processing stays on this Mac." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于在系统范围内监听额外鼠标按键。所有处理均在本机完成。" } } } },
    "permission.inputMonitoring.footnote": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "System Settings → Privacy & Security → Input Monitoring: allow MacTools." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "系统设置 → 隐私与安全性 → 输入监控，允许 MacTools。" } } } },
