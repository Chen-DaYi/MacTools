    "error.accessibilityRequired": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Grant Accessibility permission to enable rules." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先授予辅助功能权限以启用规则。" } } } },
    "error.inputMonitoringRequired": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Grant Input Monitoring permission to enable rules." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "请先授予输入监控权限以启用规则。" } } } },
    "error.tapUnavailable": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Input monitoring could not start. Check permissions and try again." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无法启动输入监听，请检查权限后重试。" } } } },
    "metadata.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Create shortcuts from keyboard/trackpad/mouse" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "从键盘、触控板和鼠标创建快捷操作" } } } },
    "metadata.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Input Remapping" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "输入重映射" } } } },
    "panel.button.settings": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Settings" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "设置" } } } },
    "panel.subtitle.activeRulesFormat": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "%d active rules" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "%d 条活跃规则" } } } },
    "panel.subtitle.noRules": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "No rules" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "无规则" } } } },
    "permission.accessibility.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Used to send remapped mouse clicks and shortcuts." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于发送重映射后的鼠标点击和快捷键。" } } } },
    "permission.accessibility.footnote": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "System Settings → Privacy & Security → Accessibility: allow MacTools." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "系统设置 → 隐私与安全性 → 辅助功能，允许 MacTools。" } } } },
    "permission.accessibility.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Accessibility" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "辅助功能" } } } },
    "permission.inputMonitoring.description": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Used to monitor keyboard, mouse, and scroll input system-wide. All processing stays on this Mac." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "用于在系统范围内监听键盘、鼠标和滚动输入。所有处理均在本机完成。" } } } },
    "permission.inputMonitoring.footnote": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "System Settings → Privacy & Security → Input Monitoring: allow MacTools." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "系统设置 → 隐私与安全性 → 输入监控，允许 MacTools。" } } } },
    "permission.inputMonitoring.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Input Monitoring" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "输入监控" } } } },
    "settings.action": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Action" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "操作" } } } },
    "settings.addRule": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add Mapping" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "添加映射" } } } },
    "settings.button.format": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Button %d" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按键 %d" } } } },
    "settings.button.record": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Record" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "录制" } } } },
    "settings.button.record.help": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Press a side or other extra mouse button to select it." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按下鼠标侧键或其他额外按键来选择它。" } } } },
    "settings.button.recording": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Press the extra mouse button to use" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按下要使用的额外鼠标按键" } } } },
    "settings.cancel": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Cancel" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "取消" } } } },
    "settings.delete": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Delete" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除" } } } },
    "settings.deleteMapping": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Delete mapping" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "删除映射" } } } },
    "settings.empty": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Add a rule, then record a keyboard, mouse, scroll, or trackpad input." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "添加规则，然后录制键盘、鼠标、滚动或触控板输入。" } } } },
    "settings.enabled": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enabled" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "启用" } } } },
    "settings.rules.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Input Mappings" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "输入映射" } } } },
    "settings.rules.subtitle": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Create shortcuts from keyboard/trackpad/mouse" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "从键盘、触控板和鼠标创建快捷操作" } } } },
    "settings.shortcutKeyCode.format": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Shortcut key code %d" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "快捷键代码 %d" } } } },
    "settings.input.record": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Record input" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "录制输入" } } } },
    "settings.input.recording": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Press any key, mouse button, or scroll" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按任意按键、鼠标按钮或滚动" } } } },
    "settings.input.record.help": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "The next keyboard key, mouse button, or scroll direction becomes this trigger." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "下一次键盘、鼠标或滚动输入将成为触发条件。" } } } },
    "settings.mouseInteraction": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Mouse interaction" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "鼠标操作" } } } },
    "settings.mouseInteraction.warning": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Double-click and long-press keep the original click available to avoid delaying or replaying input." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "双击和长按会保留原始点击，以避免延迟或重放输入。" } } } },
    "settings.keyboard.warning": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "A key without modifiers overrides normal typing while the rule is enabled." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "启用后，无修饰键会覆盖正常输入。" } } } },
    "settings.keyboard.confirmation.title": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enable unmodified key?" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "启用无修饰键？" } } } },
    "settings.keyboard.confirmation.message": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "This rule captures normal typing system-wide. You can disable it at any time." } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "此规则会在全系统范围内捕获正常输入。你可以随时停用它。" } } } },
    "settings.keyboard.confirmation.enable": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Enable" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "启用" } } } },
    "settings.shortcut.record": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Record shortcut" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "录制快捷键" } } } },
    "settings.shortcut.recording": { "localizations": { "en": { "stringUnit": { "state": "translated", "value": "Press the shortcut" } }, "zh-Hans": { "stringUnit": { "state": "translated", "value": "按下快捷键" } } } },
