{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "metadata.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switcher"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗切換"
          }
        }
      }
    },
    "metadata.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quickly switch between running windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のウインドウをすばやく切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速切换正在运行的窗口"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "快速切換正在執行的視窗"
          }
        }
      }
    },
    "permission.accessibility.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用"
          }
        }
      }
    },
    "permission.accessibility.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the switching shortcut to switch windows in other apps."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えショートカットを制御し、ほかのアプリのウインドウを切り替えるために使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于接管切换快捷键并切换其他应用窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於接管切換快速鍵並切換其他 App 的視窗。"
          }
        }
      }
    },
    "permission.accessibility.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In System Settings → Privacy & Security → Accessibility, allow MacTools."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定 → プライバシーとセキュリティ → アクセシビリティで、MacTools を許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置 → 隐私与安全性 → 辅助功能，允许 MacTools。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統設定 → 隱私權與安全性 → 輔助使用，允許 MacTools。"
          }
        }
      }
    },
    "shortcut.switcher.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switching"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗切換"
          }
        }
      }
    },
    "shortcut.switcher.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show or switch between running windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のウインドウを表示または切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示或切换正在运行的窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示或切換正在執行的視窗。"
          }
        }
      }
    },
    "shortcut.group.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switching"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗切換"
          }
        }
      }
    },
    "shortcut.group.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change the shortcut used to open Window Switcher."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替えを開くショートカットを変更します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "修改用于唤起窗口切换的快捷键。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "修改用來開啟視窗切換的快速鍵。"
          }
        }
      }
    },
    "shortcut.control.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching Shortcut"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えショートカット"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换快捷键"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換快速鍵"
          }
        }
      }
    },
    "settings.status.sectionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Status"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "状態"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "狀態"
          }
        }
      }
    },
    "settings.status.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enable Window Switching"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替えを有効にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用窗口切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟用視窗切換"
          }
        }
      }
    },
    "settings.status.enabled.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the shortcut to show and switch app windows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットでアプリのウインドウを表示・切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管切换快捷键，显示并切换应用窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接管切換快速鍵，顯示並切換 App 視窗。"
          }
        }
      }
    },
    "settings.status.disabled.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause shortcut monitoring and keep the system window switcher unchanged."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットの監視を停止し、システム標準の切り替えをそのまま使用します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂停快捷键监听，系统默认切换保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫停快速鍵監聽，維持系統預設的切換方式。"
          }
        }
      }
    },
    "settings.mode.sectionTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switching Mode"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り替えモード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换模式"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換模式"
          }
        }
      }
    },
    "settings.mode.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default Behavior"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトの動作"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认行为"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "預設行為"
          }
        }
      }
    },
    "settings.mode.keyWindow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press to Switch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーで直接切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按键直达"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按鍵直達"
          }
        }
      }
    },
    "settings.mode.keyWindow.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show a fixed window list and press the letter above an entry to switch to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定されたウインドウ一覧を表示し、項目の上の文字キーを押して直接切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示固定窗口，按条目上方字母直达。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "顯示固定視窗，按項目上方的字母直接切換。"
          }
        }
      }
    },
    "settings.mode.directCycle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cycle Windows"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続して切り替え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连续切换"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連續切換"
          }
        }
      }
    },
    "settings.mode.directCycle.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold the shortcut to cycle through windows, then release it to switch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットを押したままウインドウを順に選び、離すと切り替えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按住快捷键循环选择，松开后切换窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按住快速鍵循環選擇，放開後切換視窗。"
          }
        }
      }
    },
    "settings.sort.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "並び順"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排序"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排序"
          }
        }
      }
    },
    "settings.sort.recentUse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recent Use"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使用した順"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使用"
          }
        }
      }
    },
    "settings.sort.recentUse.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order apps by recent use so you can quickly return to the previous window."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使用したアプリ順に並べ、直前のウインドウへすばやく戻れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按最近使用的应用排列，便于快速回到上一个窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依最近使用的 App 排列，方便快速回到上一個視窗。"
          }
        }
      }
    },
    "settings.sort.fixed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed Order"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定順"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定排序"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定排序"
          }
        }
      }
    },
    "settings.sort.fixed.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Order apps consistently by name so their positions are easier to remember."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリ名で常に同じ順序に並べ、位置を覚えやすくします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按应用名称稳定排列，位置更容易记住。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依 App 名稱固定排列，位置更容易記住。"
          }
        }
      }
    },
    "error.accessibilityRevoked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessibility access was turned off, so Window Switcher is paused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセシビリティのアクセスが無効になったため、ウインドウ切り替えを一時停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能权限已关闭，窗口切换已暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輔助使用權限已關閉，視窗切換已暫停。"
          }
        }
      }
    },
    "error.accessibilityRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Window Switcher needs Accessibility access. Open Settings to allow it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウインドウ切り替えにはアクセシビリティのアクセスが必要です。設定で許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窗口切换需要辅助功能权限，请先前往设置完成授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "視窗切換需要輔助使用權限，請先前往設定完成授權。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
