    "action.show.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح شبكة الإجراءات بالقرب من المؤشر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Aktionsraster neben dem Zeiger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Action Grid near the pointer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la cuadrícula de acciones junto al puntero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez la grille d’actions près du pointeur."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポインタの近くにアクショングリッドを開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포인터 근처에서 동작 그리드를 엽니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra a grade de ações perto do cursor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает сетку действий рядом с указателем."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在指针附近打开操作网格。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在指標附近開啟操作網格。"
          }
        }
      }
    },
