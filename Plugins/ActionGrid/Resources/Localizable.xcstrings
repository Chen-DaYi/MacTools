        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستبدل هذا الإدخال الحالي بمجموعة آمنة من الإجراءات الموصى بها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
