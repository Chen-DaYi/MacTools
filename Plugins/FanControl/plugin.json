    "providers": [
      {
        "id": "fan-control",
        "kind": "dynamic",
        "staticActions": [],
        "dynamicTemplates": [
          {
            "id": "apply-preset",
            "title": "@productStrings.display-name",
            "description": "@productStrings.summary",
            "entrySource": "saved-fan-presets",
            "parameters": [
              {
                "id": "preset",
                "kind": "string",
                "isRequired": true,
                "portability": "portable"
              }
            ],
            "parameterSummary": "@productStrings.summary",
            "localOnlyIdentity": false,
            "keywords": [
              "fan",
              "control",
              "apply",
              "preset",
              "saved",
              "presets"
            ],
            "permissionIDs": [],
            "risk": "safe",
            "surfaces": [
              "unified-search",
              "global-shortcut",
              "run-link",
              "workflow",
              "automatic-rule",
              "action-grid",
              "trackpad-gesture",
              "app-intent",
              "manual"
            ],
            "automaticEligible": true,
            "externalInvocation": "confirmAlways"
          }
        ]
      }
    ]
